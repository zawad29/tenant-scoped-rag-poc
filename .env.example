# Environment for the CID-scoped RAG PoC.
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# Docker Compose reads .env for ${...} interpolation, and the services declare
# `env_file: .env` so the values are also injected into the containers. Pass it
# explicitly to be independent of the working directory:
#   docker compose --env-file .env up -d
#
# The Spring Boot app does NOT read .env, so when running it from a shell export
# the file first:
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# Every variable has the same default in application.yml, so an empty file still
# works for a local run.

# --- PostgreSQL: structured data (cid, users, documents, audit) -------------
POSTGRES_HOST=localhost
# Host port 5433, because a native PostgreSQL often occupies 5432.
POSTGRES_PORT=5433
POSTGRES_DB=ragpoc
POSTGRES_USER=ragpoc
POSTGRES_PASSWORD=ragpoc

# --- Qdrant: chunk vectors and payload --------------------------------------
QDRANT_HOST=localhost
# gRPC port (the app talks gRPC), and the HTTP port used by the dashboard.
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
# Only needed for Qdrant Cloud or an API-key-protected instance.
QDRANT_API_KEY=
QDRANT_USE_TLS=false
RAG_QDRANT_COLLECTION=chunks

# --- Local ONNX models (run scripts/fetch-models.sh first) -------------------
RAG_EMBEDDING_MODEL_PATH=models/bge-base-en-v1.5/model.onnx
RAG_EMBEDDING_TOKENIZER_PATH=models/bge-base-en-v1.5/tokenizer.json
RAG_RERANK_MODEL_PATH=models/ms-marco-MiniLM-L-6-v2/model.onnx
RAG_RERANK_TOKENIZER_PATH=models/ms-marco-MiniLM-L-6-v2/tokenizer.json

# --- Stored original PDFs ---------------------------------------------------
RAG_STORAGE_ROOT=data/files
