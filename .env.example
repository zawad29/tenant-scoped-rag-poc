# Environment for the CID-scoped RAG PoC.
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# Docker Compose reads .env for ${...} interpolation, and the services declare
# `env_file: .env` so the values are also injected into the containers. Pass it
# explicitly to be independent of the working directory:
#   docker compose --env-file .env up -d
#
# The Spring Boot app does NOT read .env, so when running it from a shell export
# the file first:
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# Every variable has the same default in application.yml, so an empty file still
# works for a local run.

# --- PostgreSQL: structured data (cid, users, documents, audit) -------------
POSTGRES_HOST=localhost
# Host port 5433, because a native PostgreSQL often occupies 5432.
POSTGRES_PORT=5433
POSTGRES_DB=ragpoc
POSTGRES_USER=ragpoc
POSTGRES_PASSWORD=ragpoc

# --- Qdrant: chunk vectors and payload --------------------------------------
QDRANT_HOST=localhost
# gRPC port (the app talks gRPC), and the HTTP port used by the dashboard.
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
# Only needed for Qdrant Cloud or an API-key-protected instance.
QDRANT_API_KEY=
QDRANT_USE_TLS=false
RAG_QDRANT_COLLECTION=chunks

# --- Model backends (run scripts/fetch-models.sh first) ----------------------
# Provider seams: `transformers` today, a hosted embedding service later; the
# reranker is `onnx` (local) or `none` (dense ordering only).
RAG_EMBEDDING_PROVIDER=transformers
RAG_EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2/model.onnx
RAG_EMBEDDING_TOKENIZER_PATH=models/all-MiniLM-L6-v2/tokenizer.json
RAG_RERANK_PROVIDER=onnx
RAG_RERANK_MODEL_PATH=models/ms-marco-MiniLM-L-6-v2/model.onnx
RAG_RERANK_TOKENIZER_PATH=models/ms-marco-MiniLM-L-6-v2/tokenizer.json

# --- Stored original PDFs ---------------------------------------------------
RAG_STORAGE_ROOT=data/files

# --- Chat generation (DeepSeek) ---------------------------------------------
# The API key is the only required value. The application still starts without
# it, but the first question fails with a message saying the key was rejected.
#   https://platform.deepseek.com/api_keys
# Leave commented out when you have no key: an empty exported value would
# override the placeholder default and stop the application from starting.
# DEEPSEEK_API_KEY=sk-...
# Provider seam: `spring.ai.model.chat` selects the ChatModel autoconfiguration.
# Changing provider means adding its starter to the pom and naming it here.
RAG_CHAT_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
# `deepseek-chat` is the non-thinking model; `deepseek-reasoner` is also valid
# but streams a separate reasoning channel this PoC does not render.
DEEPSEEK_MODEL=deepseek-chat
